# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
DATABASE_URL=postgresql://nexora:nexora_local_only@localhost:5432/nexora?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=

# Password hashing (Argon2id)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# AI (Phase 3; server only)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=15000

# Demo seed; never use these credentials in production
DEMO_ADMIN_EMAIL=admin@nexora.demo
DEMO_ADMIN_PASSWORD=Nexora-Demo-2026!
