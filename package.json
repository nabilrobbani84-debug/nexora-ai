{
  "name": "nexora-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise omnichannel customer retention and lead scoring CRM",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @nexora/api db:generate",
    "db:migrate": "pnpm --filter @nexora/api db:migrate",
    "db:seed": "pnpm --filter @nexora/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
